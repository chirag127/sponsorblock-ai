# Byte-compiled / optimized / script files
*.pyc
__pycache__/
*.pyo
*.pyd

# Distribution / packaging
*.egg-info/
build/
dist/
*.egg

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the application. Handle them with caution.
*.spec

# Installer logs
*.log

# Unit test / coverage reports
.coverage
.coverage.*
.cache
htmlcov/
.pytest_cache/

# C extensions
*.so

# IDE specific files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Virtual environment
venv/
env/
.venv/

# OS generated files
.DS_Store
Thumbs.db

# Local environment variables
.env
.env.*.local

# Ruff cache
.ruff_cache/

# Uvicorn / FastAPI logs
*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints
